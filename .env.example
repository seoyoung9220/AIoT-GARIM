# 이 파일을 .env로 복사해서 값을 채운다.
#   cp .env.example .env
# .env 자체는 저장소에 올라가지 않으며(.gitignore), 서버에도 git pull로 따라가지 않는다.
# 배포 서버에서는 /opt/garim/.env 에 직접 만들고 chmod 600 을 적용한다.

# --- CLOVA OCR (API Gateway) ---
OCR_INVOKE_URL=
OCR_SECRET_KEY=

# --- CLOVA Studio (HyperCLOVA X 추론 + 임베딩 공용 키) ---
CLOVA_STUDIO_KEY=

# --- RAG 정책 검색용 pgvector DB ---
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- 저장 경로 (선택) ---
# 페이지 이미지를 풀어놓을 폴더. 생략하면 <프로젝트 루트>/output_images 를 쓴다.
# 개인정보가 담긴 이미지가 쌓이는 곳이라 디스크 여유가 있는 경로로 옮길 때 지정한다.
GARIM_OUTPUT_DIR=

# 키가 없어도 서버는 뜬다. 다만 OCR 키가 없으면 /analyze가 실패하고,
# DB에 접속하지 못하면 /mask는 규칙 기반 정책으로 대체된다.
